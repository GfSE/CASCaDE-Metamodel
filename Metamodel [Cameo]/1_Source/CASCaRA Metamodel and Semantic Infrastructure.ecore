<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="CASCaRA Metamodel">
  <eAnnotations source="### Design goals&#xA;- **Separated syntax and semantics**: The metamodel governs the graph pattern independently of the ontology. Any software depends on the metamodel and doesn’t need change, when the ontology evolves over time.&#xA;- **Interoperability**: A graph pattern is designed which may be represented in RDF, JSON-LD, GQL and OOP alike. Bidirectional transformations between any of those formats shall be possible without data-loss. Admittedly this ‘sweet-spot’ reduces expressivity when compared with any of the listed data formats, but the choice of implementation technologies is maximized. Verification and validation will show that the expressivity of the CASCaRA Graph is sufficient for the purpose.&#xA;- **Federated data-spaces**: The general use of URIs (or UUIDs with namespace) as identifier like RDF allows linked data to reside in multiple internet servers and still form a valid graph which can be seamlessly traversed and queried.&#xA;- **Standard queries**: The same queries shall be applicable, no matter where the data came from originally.&#xA;"
      references="#/"/>
  <eClassifiers xsi:type="ecore:EClass" name="aProperty" eSuperTypes="#//Item">
    <eAnnotations source="Each property belongs to a single [[anEntity]], [[aRelationship]] or [[aPackage]]. A property has *no* identifier, thus a property update results in a new revision of the item to which it belongs. Is project data ('payload') having a clear meaning, datatype and range through its type [[Property]].&#xA;&#xA;Details:&#xA;- aProperty may be required or not depending on the attributes minCount and maxCount of its type, but an existing property must have a value.&#xA;- aProperty value can be mutated.&#xA;- aProperty value cannot be deleted, the whole aProperty must be deleted, if so desired.&#xA;- the value of aProperty must conform with the datatype, length, minInclusive, maxInclusive or pattern of its type [[Property]]. Not all restrictions apply for all datatypes.&#xA;- aProperty may be composed of multiple aProperties to form a structured data set according to its type.&#xA;"
        references="#//aProperty"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" ordered="false" lowerBound="1"
        eType="#//Property">
      <eAnnotations references="#//aProperty/type"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" ordered="false"
        lowerBound="1" upperBound="-1">
      <eAnnotations source="The value of a [[aProperty]].&#xA;&#xA;Details:&#xA;- If the datatype of the property's type is string, the value is a language string consisting of value and IETF language tag ('multiLangueText'). If there is a value in only one language, the language tag is optional.&#xA;- Some convention is needed when a string is an expression - out of scope at present.&#xA;- Otherwise the value is a simple value.&#xA;- The rules of XML Schema apply, for example value compatibility: &quot;99&quot;^^xsd:integer  = &quot;99.0&quot;^^xsd:decimal."
          references="#//aProperty/value"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="composes" ordered="false"
        lowerBound="1" upperBound="-1" eType="#//aProperty" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="aSourceLink" eSuperTypes="#//aLink">
    <eAnnotations source="A link instance serving as source for a reified [[aRelationship]]. aSourceLink has *no* identifier, thus a property update results in a new revision of the item to which it belongs. &#xA;&#xA;From a semantic point of view, there is no need to make a distinction between aSourceLink and aTargetLink at the metamodel level. The distinction can be done and *is made* at ontology level in the [[CASCaRA Semantic Infrastructure]]. However it is much easier to check the pattern/schema/shape and to ingest data, if the itemType makes the distinction.&#xA;&#xA;Details:&#xA;- aSourceLink may be required or not depending on the attributes minCount and maxCount of its type, but an existing one must have a value.&#xA;&#xA;Example: &#xA;- A relationship 'worksFor' can relate an organization instance (target) to one or multiple person instances using [[aSourceLink]] named 'Employee'."
        references="#//aSourceLink"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Identifiable" abstract="true" eSuperTypes="#//Item">
    <eAnnotations source="All sub-classes of this class (in UML terms) are identifiable, means they have an identifier, a title (name) and optionally a description. &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes are inherited by its subclasses.&#xA;- All type level items in the upper part of the diagram are commonly released and made available with an URL path including the revision. Hence, multiple revisions of a type set may exist in parallel.&#xA;- All instance level items in the lower part of the diagram may be updated individually with change information *modified*, *revision*, *priorRevision* and *creator*. The prior revision identifier is memorized to support change history and branching. In case of a merge, there are two prior revisions.&#xA;&#xA;"
        references="#//Identifiable"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" ordered="false" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A globally unique identifier, either a fully qualified URI or a name with namespace standing for an URI, see [[aPackage]] [[context]]."
          references="#//Identifiable/id"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A multiLanguageText.  Maps to dcterms:description.&#xA;&#xA;Details:&#xA;- Here a multiplicity [0..1] is given, but in fact that depends on the itemType. &#xA;- For all types (Enumeration, Property, Link, Entity and Relationship), a title is mandatory. &#xA;- In case of anEntity at least one of title or description is required, because it must be possible to represent a text paragraph as anEntity, which simply does not have a title.&#xA;- In case of aRelationship both title and description are optional. If missing the title and/or description of the respective Relationship type applies. This avoids lots of repetition in real-world data-sets.&#xA;- The same applies for aProperty, aSourceLink and aTargetLink; both title and description are optional."
          references="#//Identifiable/description"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modified" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A ISO-8601 DateTime value recording the point in time of the last change.&#xA;"
          references="#//Identifiable/modified"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revision" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A unique string identifying the revision of the entity or relationship instance."
          references="#//Identifiable/revision"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorRevision" ordered="false"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="Links to the previous revisions of an entity or relationship instance. It is a list with &#xA;- zero elements, if it is the first revision,&#xA;- one element for a subsequent revision or&#xA;- two elements when two branches are merged."
          references="#//Identifiable/priorRevision"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="creator" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="The person committing the last change. Is often an e-mail address."
          references="#//Identifiable/creator"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Element" abstract="true" eSuperTypes="#//Identifiable">
    <eAnnotations source="A super-class (in UML terms) of [[Entity]] (type of entities) and [[Relationship]] (type of relationships). &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes and associations are inherited by its sub-classes Entity and Relationship.&#xA;- The globalTitle of the Elements is used to integrate the instances of a partial graphs to an overarching CASCaRA graph.&#xA;- Best practice is to release a set of CASCaRA types (thus all sub-classes of Element) from time to time as a whole. The version id is included in the directory path, so that multiple releases can be hosted in parallel. &#xA;"
        references="#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedProperty" ordered="false"
        upperBound="-1" eType="#//Property"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A multiLanguageText. Maps to dcterms:title or rdf:label.&#xA;&#xA;Details:&#xA;- Here a multiplicity [0..1] is given, but in fact that depends on the itemType. &#xA;- For all types (Enumeration, Property, Link, Entity and Relationship), a title is mandatory. &#xA;- In case of anEntity at least one of title or description is required, because it must be possible to represent a text paragraph as anEntity, which simply does not have a title.&#xA;- In case of aRelationship both title and description are optional. If missing, the title and/or description of the respective Relationship type applies. This avoids lots of repetition in real-world data-sets.&#xA;- The same applies for aProperty, aSourceLink and aTargetLink; both title and description are optional and the respective properties of the type apply."
          references="#//Element/title"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="definition" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A multiLanguageText mandatory for all types. Maps to skos:definition.&#xA;"
          references="#//Element/definition"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="icon" ordered="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="An icon defined with a type can be used to decorate the instances.&#xA;&#xA;Example: &#xA;- Folders as sub-type of Organizer and thus Entity may specify a UTF-8 character 🗀 for use by folders grouping certain model-elements.&#xA;- A data-URL is also permitted as an icon."
          references="#//Element/icon"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="globalTitle" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="The title assigned by matching the title with the terms of the ontology by the 'globalize' operation. "
          references="#//Element/globalTitle"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Link" eSuperTypes="#//Configurable">
    <eAnnotations source="Is an identifiable link type. It is used as a named connector between a reified [[Relationship]] and its source and target, or as a named connector between an [[Entity]] and a directly related target. A Link is an owl:ObjectProperty.&#xA;&#xA;Details:&#xA;- A link type can be specialized by another. For example the most global 'linksTarget' may be specialized by 'depicts'.&#xA;- If *revisionAware* is set for a Link, each endpoint of its instances is deleted as soon as the referenced endpoint itself is updated.&#xA;&#xA;Examples: &#xA;- An Organizer (semantic sub-type of [[Entity]]) may list Requirements (another semantic sub-type of Entity) to construct a document outline. As such the Link type *lists* is specified as enumeratedTargetLink by Organizer.&#xA;- An [[Entity]] Requirement might have a property with enumerated values ['high', 'medium' or 'low']. This is represented by a Link type pointing to an [[Enumeration]] defining those values. "
        references="#//Link"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedEndpoint" ordered="false"
        lowerBound="1" upperBound="-1" eType="#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revisionAware" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="Indicates whether an instance of this type is valid for a *specific* or *any* revision of the specified endpoints. &#xA;&#xA;Details:&#xA;- If *revisionAware* is set, all references occurring as endpoint of its instances are deleted as soon as the endpoint itself is updated; otherwise they are preserved.&#xA;- In rare cases only one of a [[Relationship]]'s [[enumeratedSourceLink]] or [[enumeratedTargetLink]] can be 'revisionAware'.&#xA;&#xA;Examples:&#xA;- [[aLink]] named *lists* of an outline (folder) shall continue to reference an endpoint, even if updated. So *revisionAware* of its [[Link]] type is omitted or set to 'false'.&#xA;- [[aRelationship]] named *verifies* shall apply between specific revisions of a *test-case* and a *requirement*. So the types of both [[aSourceLink]] and [[aTargetLink]] set *revisionAware* to 'true'. If the *requirement* is updated, it has no more *verifies* relationship, until explicitly set after repeating the *test-case*. &#xA;"
          references="#//Link/revisionAware"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specializes" ordered="false"
        eType="#//Link"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="aTargetLink" eSuperTypes="#//aLink">
    <eAnnotations source="A link instance pointing to the target of a reified [[aRelationship]] or to one or more targets of [[anEntity]]. aTargetLink has *no* identifier, thus a property update results in a new revision of the item to which it belongs.&#xA;&#xA;From a semantic point of view, there is no need to make a distinction between aSourceLink and aTargetLink at the metamodel level. The distinction can be done and *is made* at ontology level in the [[CASCaRA Semantic Infrastructure]]. However it is much easier to check the pattern/schema/shape and to ingest data, if the itemType is explicit.&#xA;&#xA;Details:&#xA;- aTargetLink may be required or not depending on the attributes minCount and maxCount of its type [[Link]], but an existing one must have a value.&#xA;&#xA;Examples: &#xA;- A relationship 'worksFor' can relate one or multiple person instances to an organization instance (target) using [[aTargetLink]] named 'Employer'.&#xA;- An organizer (see [[CASCaRA Semantic Infrastructure]]) such as a chapter title (folder) in an outline can point to one or more contained items, be it anEntity, aRelationship or other.&#xA;- [[anEntity]], [[aRelationship]] or [[aPackage]] may point to an [[enumeratedValue]] of an [[Enumeration]]. The value must belong to an enumeration listed by [[enumeratedTargetLink]] of its type ."
        references="#//aTargetLink"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasEndpoint" ordered="false"
        upperBound="-1" eType="#//enumeratedValue" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Entity" eSuperTypes="#//Element">
    <eAnnotations source="Entity is a type of model elements, such as a system component or a requirement. An Entity is an owl:Class.&#xA;&#xA;Details:&#xA;- Entity should have a title (name) and may have a description (definition).&#xA;- Entity may specify (configure) zero to many types of properties its instances may have. &#xA;- The definitions of the entity together with those of the properties may be used to build user dialogs with input verification as well as to check its instances whether all property values have a correct type and value range as well as whether all required ones are present.&#xA;"
        references="#//Entity"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specializes" ordered="false"
        eType="#//Entity"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedTargetLink" ordered="false"
        upperBound="-1" eType="#//Link"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="anEntity" eSuperTypes="#//anElement">
    <eAnnotations source="Is used for instances of model-elements such as a system component or a requirement. Is project data ('payload') having a clear meaning through its type [[Entity]].&#xA;&#xA;Details:&#xA;- anEntity must have either a title or a description - or both. This allows to compose documents including text paragraphs without title. &#xA;- anEntity's type enumerates the types of [[aProperty]] it may have.&#xA;- anEntity's type also enumerates the types of [[aTargetLink]] it may have.&#xA;"
        references="#//anEntity"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" ordered="false" lowerBound="1"
        eType="#//Entity">
      <eAnnotations references="#//anEntity/type"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasTargetLink" ordered="false"
        upperBound="-1" eType="#//aTargetLink" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="aRelationship" eSuperTypes="#//anElement">
    <eAnnotations source="Is used for relations between entities, such as a 'system component satisfies a requirement'. All relationships are bilateral and directed. Is project data ('payload') having a clear meaning through its type [[Relationship]].&#xA;&#xA;Details:&#xA;- This is a reified graph edge and must have exactly one [[aSourceLink]] and [[aTargetLink]] each. &#xA;- aRelationship is deleted, if either its aSourceLink or its aTargetsLink is deleted.&#xA;- Its aSourceLink and its aTargetLink must have a type listed as [[enumeratedSourceLink]] resp. [[enumeratedTargetLink]] by its type [[Relationship]].&#xA;- Similarly, its type enumerates the types of [[aProperty]] it may have.&#xA;- Even though aRelationship may have an individual title, it is advised to omit it and assume its type's title to assure that relationships of the same type are named equally.&#xA;"
        references="#//aRelationship"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" ordered="false" lowerBound="1"
        eType="#//Relationship">
      <eAnnotations references="#//aRelationship/type"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasTargetLink" ordered="false"
        lowerBound="1" eType="#//aTargetLink" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasSourceLink" ordered="false"
        lowerBound="1" eType="#//aSourceLink" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Item" abstract="true">
    <eAnnotations source="The super-class (in UML terms) of all CASCaRA metamodel items specifying the type of item to allow for simple schema checking and transformation.&#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;"
        references="#//Item"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="itemType" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="Denotes CASCaRA types and instances in terms of this metamodel. It must be made explicit in all representations without native reasoner, such as in object-oriented programming, JSON, JSON-LD and XML. It may be omitted in RDF/OWL, as the top of the type hierarchy shall correspond to the metamodel itemType (see [[CASCARA Semantic Infrastructure]] and the itemType can be derived with a standard OWL reasoner.&#xA;&#xA;Details:&#xA;- Here it is modeled as a string, but in fact it is an enumerated value for each of the concrete metamodel items (represented as UML classes), thus either Enumeration, Link, Property, Entity, Relationship, aPackage, aSourceLink, aTargetLink, aProperty, anEntity or aRelationship."
          references="#//Item/itemType"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="aLink" abstract="true" eSuperTypes="#//Item">
    <eAnnotations source="Is a super-class (in UML terms) for link instances [[aSourceLink]] and [[aTargetLink]].&#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- aLink may have multiple enumerated endpoints (references).&#xA;- If its type [[Link]] is set to *revisionAware*, the enumeratedEndpoint is deleted, if the endpoint itself is updated.&#xA;- If its type [[Link]] is not set to *revisionAware*, the enumeratedEndpoint remains, if the endpoint itself is updated.&#xA;- The enumeratedEndpoint is deleted, if the endpoint itself is deleted.&#xA;- aLink is deleted, if it has no more enumeratedEndpoints.&#xA;"
        references="#//aLink"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" ordered="false" lowerBound="1"
        eType="#//Link"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasEndpoint" ordered="false"
        lowerBound="1" upperBound="-1" eType="#//anElement" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="anElement" abstract="true" eSuperTypes="#//Identifiable">
    <eAnnotations source="A super-class (in UML terms) of [[anEntity]] and [[aRelationship]]. &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes and associations are inherited by its sub-classes.&#xA;&#xA;&#xA;"
        references="#//anElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasProperty" ordered="false"
        upperBound="-1" eType="#//aProperty" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A multiLanguageText. Maps to dcterms:title or rdf:label.&#xA;&#xA;Details:&#xA;- Here a multiplicity [0..1] is given, but in fact that depends on the itemType. &#xA;- For all classes (Enumeration, Property, Link, Entity and Relationship), a title is mandatory. &#xA;- In case of anEntity at least one of title or description is required, because it must be possible to represent a text paragraph as anEntity, which simply does not have a title.&#xA;- In case of aRelationship both title and description are optional. If missing the title and/or description of the respective Relationship class applies. This avoids lots of repetition in real-world data-sets.&#xA;- The same applies for aProperty, aSourceLink and aTargetLink; both title and description are optional."
          references="#//anElement/title"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Property" eSuperTypes="#//Configurable">
    <eAnnotations source="Every type [[Entity]] and [[Relationship]] can have an individual set of configurable properties, each of which is uniquely defined by id (name), datatype and range. A Property is an owl:DatatypeProperty.&#xA;&#xA;Details:&#xA;- Property type must have a title and may have a description.&#xA;- Property type may define a minimum and maximum count of values.&#xA;- Property type must define a datatype and may restrict its range by minInclusive, maxInclusive or or a pattern defined by Regular Expression.&#xA;- A property type may define a default value which must of course satisfy its own data type and range.&#xA;- Property type may be composed of multiple property types to form a structured data type (xs:complexType). The structure must be a tree, thus without cyclic dependency.&#xA;&#xA;Example: &#xA;- A requirement might have a configurable property, such as 'Category' with datatype xs:string with a maximum length of 32. &#xA;- A *Priority* with a single choice of values ['high', 'medium', 'low']“ would be defined as a [[Link]] to an [[Enumeration]].&#xA;"
        references="#//Property"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="datatype" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="One of the xs: data types. Shall be anyURI." references="#//Property/datatype"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxLength" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="Maximum length of a property value with datatype 'xs:string'. Is not allowed with any other datatype."
          references="#//Property/maxLength"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minInclusive" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="The minimum value a property of this type may have. May be applied only for numeric datatypes.  It the intrinsic minimum value of the datatype by default."
          references="#//Property/minInclusive"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxInclusive" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="The maximum value a property of this type may have. May be applied only for numeric datatypes. It the intrinsic maximum value of the datatype by default."
          references="#//Property/maxInclusive"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pattern" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A Regular Expression that must evaluate successfully with the property value. Can also be used to limit the number of decimals of a number, as there is no restriction like xs:fractionDigits in SHACL."
          references="#//Property/pattern"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specializes" ordered="false"
        eType="#//Property"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="composes" ordered="false"
        upperBound="-1" eType="#//Property"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Relationship" eSuperTypes="#//Element">
    <eAnnotations source="A type of relationships between two entities to allow assertions such as 'a system component satisfies a requirement'. All relationships are bilateral and directed. This allows for statements according to propositional logic. They can be easily mapped to many technologies such as RDF or even ReqIF. Being reified, a Relationship is an owl:Class.&#xA;&#xA;Details:&#xA;- Relationship must have a title (name) and may have a description (definition).&#xA;- Relationship lists zero to many property types its instances may have.&#xA;- Relationship may define (configure) entitiy types or relationship types, whose instances are eligible as source resp. target in a relationship. If none are defined, all entities and relationships are eligible.&#xA;- Relationship is reified (as a rdfs:Resource in RDF), so that it can be a source or target of another Relationship - to make a statement on a statement.&#xA;- The definitions of a relationship together with those of their properties may be used to build user dialogs with input verfication and to check its instances whether all properties have a correct type and value range as well as whether all required ones are present.&#xA;"
        references="#//Relationship"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specializes" ordered="false"
        eType="#//Relationship"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedSourceLink" ordered="false"
        lowerBound="1" eType="#//Link"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedTargetLink" ordered="false"
        lowerBound="1" eType="#//Link"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="globalReversed" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="If set, the instances of the Relationship are interpreted in reverse direction when evaluated in the global graph.&#xA;&#xA;Example:&#xA;- If the ontology defines a term 'satisfies', an incoming relationship named 'satisfied-by' is reversed and the globalTitle is set to 'satisfies' and globalReversed is set to 'true'."
          references="#//Relationship/globalReversed"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Enumeration" eSuperTypes="#//Element">
    <eAnnotations source="A type defining a set of enumerated values, where each value has an *id* and either a multi-language *title* in case of datatype xs:string or otherwise a simple *value*.&#xA;&#xA;A corresponding [[Link]] type must be defined with an [[enumeratedEndpoint]] to this *Enumeration*. For example, anEntity 'Requirement-XYZ' has aTargetLink 'Priority' pointing to aValue 'medium' being an instance of Enumeration 'Priority-Values'.&#xA;&#xA;Details:&#xA;- The set of enumerated values of a specialized Enumeration must be a subset of those of its super-type.&#xA;- Enumeration is modelled as a sub-class of [[Element]], however there is no known use-case where configurable properties (*enumeratedProperty*) make sense. &#xA;"
        references="#//Enumeration"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specializes" ordered="false"
        eType="#//Enumeration"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="datatype" ordered="false"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="A unit as defined by the International System of Units (SI). A unit can only be defined for a numeric datatype. By default the property has no unit."
          references="#//Enumeration/datatype"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="enumeratedValue" ordered="false"
        upperBound="-1" eType="#//enumeratedValue" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="aPackage" eSuperTypes="#//anEntity">
    <eAnnotations source="A container for any selection of identifiable metamodel items. Standardized and addressable types can be omitted from aPackage. aPackage may contain specific types (from organization or project ontologies) plus the instances of interest.&#xA;&#xA;Details:&#xA;- The type of aPackage is formally [[Entity]], but should be a sub-type of Organizer (see [[CASCaRA Semantic Infrastructure]]).&#xA;- aPackage can be nested, as it is itself an identifiable metamodel item and can hence be part of the [[graph]] of one or more parent aPackage.&#xA;- Additional properties such as *license* or *contributor* are defined as an enumeratedProperty in its type Package.&#xA;"
        references="#//aPackage"/>
    <eAnnotations references="#//aPackage"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="context" ordered="false"
        upperBound="-1">
      <eAnnotations source="A list of IRIs per namespace abbreviation. Used as sequence of @prefix in RDF/Turtle, sequence of xmlns: in XML and @context in JSON-LD."
          references="#//aPackage/context"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="graph" ordered="false"
        upperBound="-1" eType="#//Identifiable" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Configurable" abstract="true" eSuperTypes="#//Identifiable">
    <eAnnotations source="Besides 'native' properties which are defined by the metamodel (such as title and description), an [[Element]] can have configurable properties and links. Those configurable properties and links support a dynamic data model, so that the ontology can evolve over time without software change. Additional detail such as data type and range can be provided to build dynamic forms, for example. It is in fact the core feature to separate CASCaRA syntax and semantics.&#xA;&#xA;Details:&#xA;- This class is abstract."
        references="#//Configurable"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minCount" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="The minimum count of a 'configurable' defined by an [[Element]] type for its instances. Thus [[anElement]] owning [[aProperty]] or [[aLink]] must have at least this number of occurrences. Is '0' by default.&#xA;&#xA;For example, if a property type 'Priority' has a minCount=1 and a requirement type specifies an enumeratedProperty 'Priority', a requirement instance must have at least one property of type Priority (with a value). &#xA;"
          references="#//Configurable/minCount"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxCount" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="The maximum count of a 'configurable' defined by an [[Element]] type for its instances. Thus  [[anElement]] owning [[aProperty]] or [[aLink]] must have at most this number of occurrences. Is '0' by default.&#xA;&#xA;For example, if a property type 'Priority' has a maxCount=1 and a requirement type specifies an enumeratedProperty 'Priority', a requirement instance must have no more than one property of type Priority (with a value)."
          references="#//Configurable/maxCount"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue" ordered="false">
      <eAnnotations source="Optional default value(s) in case an Element's property does not have an individual value when instantiated.  It may be changed later on, unless readOnly is set, and must follow the definitions of the Property type resp. Link type at all times, of course.&#xA;&#xA;Details:&#xA;- In case of Link, the value must be an identifier of Enumeration, Entity or Relationship.&#xA;- In case of Property, a value of the datatype as specified must be asserted.&#xA;- If the datatype is string, the value is a language string consisting of value and IETF language tag ('multiLangueText').&#xA;- Otherwise the value is a simple value.&#xA;- Values of all datatypes are represented as a string in all data formats, even JSON and JSON-LD.&#xA;- In the reference implementation, there is no difference in the instance's value, whether taken from the defaultValue or assigned explicitly. If an explicit value is removed, the defaultValue shall be reassigned. &#xA;"
          references="#//Configurable/defaultValue"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="readOnly" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="The property value of an individual [[aPackage]], [[anEntity]] or [[aRelationship]] is assiged with the defaultValue at creation and may not be updated or deleted during the individual's lifetime. &#xA;&#xA;For example, this feature is needed to represent SysML v2 models where constant attributes are defined at type level and assigned to all instances.&#xA;"
          references="#//Configurable/readOnly"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="globalTitle" ordered="false"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="The title assigned by matching the title with the terms of the ontology by the 'globalize' operation. "
          references="#//Configurable/globalTitle"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="enumeratedValue">
    <eAnnotations source="Is a defined value of an [[Enumeration]]. If present, it must have either a *title* or a *value*.&#xA;&#xA;Details:&#xA;- In case of datatype xs:string, a *title* must be defined with one or more string values in different languages ('multiLanguageText').&#xA;- In case of all other datatypes *value* must be a simple value. &#xA;- in RDF, an enumeratedValue is an individual of its Enumeration. &#xA;- In JSON-LD and XML, any enumeratedValue is defined as a child element of the object resp. tag representing the Enumeration.&#xA;&#xA;An instance (anEntity, aRelationship or aPackage) then has [[aTargetLink]] pointing to zero to many (0..n) enumeratedValues with [[hasEndpoint]]. The permissible number of values is defined by minCount and maxCount of the type of [[aTargetLink]].&#xA;&#xA;"
        references="#//enumeratedValue"/>
  </eClassifiers>
</ecore:EPackage>
