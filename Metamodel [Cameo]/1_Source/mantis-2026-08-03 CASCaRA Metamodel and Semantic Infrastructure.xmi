         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2026x_14400d4_1778852531384_599025_20279"
                           name="linksEnumeratedValue">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1778856260885_197592_20727"
                           body="A [[Link]] subclass for use by an [[Entity]] or [[Relationship]] to enumerate eligible [[Enumeration]] classes that can serve as a target.&#xA;&#xA;Example:&#xA;- A [[Requirement]] specifies a priority, where the priority values are defined in an [[Enumeration]] class and the link to use as linksEnumeration.&#xA;- A meaningful link name such as 'has Priority' can be created through a subclass of linksEnumeration.">
               <annotatedElement xmi:idref="_2026x_14400d4_1778852531384_599025_20279"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
