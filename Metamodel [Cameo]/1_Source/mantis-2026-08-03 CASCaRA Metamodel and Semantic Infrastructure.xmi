                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1757683897710_107075_20955"
                           body="A concept is a unit of knowledge created by a unique combination of characteristics. It corresponds to a *mvf:Entry*, see [Multiple Vocabulary Facility (MVF)](https://www.omg.org/spec/MVF/1.0/PDF).&#xA;&#xA;A concept is considered a normalized (cross-domain) term in the Product Information Graph and can be replaced by a term used in a certain domain or community for display. A concept name (= title) usually is given with a namespace. ">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1757666631132_920918_18866"/>
            </ownedComment>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1758033447750_768452_18478"
                             name="rdfs*label"
