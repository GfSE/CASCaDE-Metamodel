         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2026x_14400d4_1778760662539_45245_19508"
                           name="graph">
            <memberEnd xmi:idref="_2026x_14400d4_1778760662539_811343_19509"/>
            <memberEnd xmi:idref="_2026x_14400d4_1778760662540_505941_19510"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1786295207851_173671_38444"
                           body="A list of identifiable CASCaRA items, both classes and instances, thus all concrete meta-class items except aProperty, aSourceLink and aTargetLink, which are included in their parent items. A modification of aProperty, aSourceLink or aTargetLink results in a new revision of the whole parent item.">
               <annotatedElement xmi:idref="_2026x_14400d4_1778760662539_45245_19508"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2026x_14400d4_1778760662540_505941_19510"
                       visibility="public"
                       type="_2026x_14400d4_1778225937554_355279_18509"
                       association="_2026x_14400d4_1778760662539_45245_19508">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778760703370_234198_19521"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2026x_14400d4_1778760703370_888501_19522"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2026x_14400d4_1778799696563_549743_19891"
                           name="composes">
            <memberEnd xmi:idref="_2026x_14400d4_1778799696563_102521_19892"/>
            <memberEnd xmi:idref="_2026x_14400d4_1778799696564_455430_19893"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2026x_14400d4_1784531708200_831990_18478"
                           name="Configurable"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1784533204863_813417_18811"
                           body="Besides native properties such as title and description, [[Element]]s can have configurable properties and links. Those configurable properties and links support a dynamic data model, so that the ontology can evolve over time without software change. Sufficient detail such as data type and range can be provided to build dynamic forms, for example. It is in fact the core feature to separate CASCaRA syntax and semantics.&#xA;&#xA;Details:&#xA;- This class is abstract">
               <annotatedElement xmi:idref="_2026x_14400d4_1784531708200_831990_18478"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741776786205_509472_44473"
                             general="_19_0_3_71e0233_1741776602722_98160_44400"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741259644097_123264_43470"
                             name="minCount"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Integer"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1749107614815_958901_42099"
                              body="An instance must have at least this number of properties of this class. Is '0' by default. This applies to both instances of a Property class and a Link class.&#xA;&#xA;For example, if a property class 'Priority' has a minCount=1 and a requirement class specifies an enumeratedProperty 'Priority', a requirement instance must have at least one property of class Priority (with a value). ">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741259644097_123264_43470"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741259720991_569665_43474"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741259741852_805697_43476"
                             name="maxCount"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Integer"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1749107629243_207081_42102"
                              body="An instance must have at most this number of properties of this class. Is unbounded (infinite) by default. This applies to both instances of a Property class and a Link class.&#xA;&#xA;For example, if a property class 'Priority' has a maxCount=1 and a requirement class specifies an enumeratedProperty 'Priority', a requirement instance must have no more than one property of class Priority (with a value).">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741259741852_805697_43476"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741259763566_139503_43480"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741260278956_301250_43534"
                             name="defaultValue"
                             visibility="public">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1741343480727_84457_44250"
                              body="Optional default value(s) in case a modelElement's property does not have an individual value when instantiated.  It may be changed later on, unless readOnly is set, and must follow the definitions of the Property (class) resp. Link (class) at all times, of course.&#xA;&#xA;Details:&#xA;- In case of Link, the value must be an identifier of Enumeration, Entity or Relationship.&#xA;- In case of Property, a value of any datatype may be asserted as specified.&#xA;- If the datatype is string, the value is a language string consisting of value and IETF language tag ('multiLangueText').&#xA;- Otherwise the value is a simple value.&#xA;- Values of all datatypes are represented as a string in all data formats, even JSON and JSON-LD.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741260278956_301250_43534"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741260289120_132219_43538"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784384627446_727353_18463"
                             name="readOnly"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784384753389_357321_18466"
                              body="The property value of an instance may not be updated or deleted, once assigned. &#xA;&#xA;If a defaultValue is specified, it is assigned when the property is instantiated and never modified. For example, this feature is needed to represent SysML v2 models, for example, where constant attributes can be assigned at class level.&#xA;">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784384627446_727353_18463"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784384653120_241200_18464"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1785134090722_706278_18457"
                             name="globalTitle"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1785134124172_910466_18460"
                              body="The title assigned by matching the title with the terms of the ontology by the 'globalize' operation. ">
                  <annotatedElement xmi:idref="_2026x_14400d4_1785134090722_706278_18457"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1785134113447_250770_18458"/>
            </ownedAttribute>
         </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package"
                        xmi:id="_2024x_3_71e0233_1771839451123_494221_23070"
                        name="CASCaRA Semantic Infrastructure">
         <ownedComment xmi:type="uml:Comment"
                        xmi:id="_2026x_14400d4_1785160739016_78836_18464"
                        body="The CASCaRA Semantic Infrastructure complements the CASCaRA Metamodel by further sub-classing its items. The idea is to keep the metamodel as simple as possible and add semantic precision through the semantic infrastructure.&#xA;&#xA;Let's consider the paradigma of separating syntax and semantics with the objective to shield the software from an ontology under evolution over time. In all likelihood, the CASCaRA Semantic Infrastructure will be used by software for reasons of simplicity. Therefore it is advised to treat the semantic infrastructure similarly to the metamodel: Change it seldomly and keep it downward compatible. Thus, software built assuming an older version shall not break when a new version is adopted. So the semantic infrastructure can be seen as an intermediary layer between metamodel and ontology which is managed like the metamodel.&#xA;&#xA;Thus, an ontology for use with the CASCaRA Metamodel SHOULD sub-class the items of the CASCaRA Semantic Infrastructure.&#xA;">
            <annotatedElement xmi:idref="_2024x_3_71e0233_1771839451123_494221_23070"/>
         </ownedComment>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771754749869_479288_19765"
                           name="Actor">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771840512132_46659_23421"
                           body="An 'Actor' is a fundamental model element type representing an active entity, be it an activity, a process step, a function, a system component or a role.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771754749869_479288_19765"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771755040254_521540_19921"
                             general="_2024x_3_71e0233_1771752760974_602036_19203"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1783267139656_804311_19607"
                             visibility="public"
                             type="_2026x_14400d4_1783266744051_785849_19428"
                             association="_2026x_14400d4_1783267139655_829396_19606"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771834044123_574439_21691"
                           name="depicts">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771847243419_404996_23540"
                           body="A [[Link]] class for use by [[View]] to enumerate eligible [[Entity]] and/or [[Relationship]] classes that can own a view (e.g. a state diagram describing the behavior of a component where the latter owns the depicting view).">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771834044123_574439_21691"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771834704245_878527_22091"
                             general="_2024x_3_71e0233_1771799885159_867928_20697"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771834464663_100935_22045"
                             visibility="public"
                             type="_2024x_3_71e0233_1771752760974_602036_19203"
                             association="_2024x_3_71e0233_1771834464663_544213_22044">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771848388079_112871_23862"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771848388079_934604_23863"
                            value="*"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771834464663_544213_22044"
                           name="enumeratedEndpoint">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771834464663_100935_22045"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771834464663_125780_22046"/>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771834464663_125780_22046"
                       visibility="public"
                       type="_2024x_3_71e0233_1771834044123_574439_21691"
                       association="_2024x_3_71e0233_1771834464663_544213_22044">
