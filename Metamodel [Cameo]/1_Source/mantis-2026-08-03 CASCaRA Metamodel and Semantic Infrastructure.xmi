                       association="_2026x_14400d4_1778225337966_648177_18476">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778225337968_969247_18479"/>
            </ownedEnd>
         </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package"
                        xmi:id="_2024x_3_71e0233_1771839371696_26166_23059"
                        name="CASCaRA Metamodel">
         <ownedComment xmi:type="uml:Comment"
                        xmi:id="_2026x_14400d4_1785159450257_506503_18457"
                        body="## Design goals&#xA;- **Separated syntax and semantics**: The metamodel governs the graph pattern independently of the ontology. Any software depends on the metamodel and doesn’t need change, when the ontology evolves over time.&#xA;- **Simple transformation**: A graph pattern is designed which may be represented in RDF, JSON-LD, GQL and OOP alike. Bidirectional transformations between any of those formats shall be possible without data-loss. Admittedly this ‘sweet-spot’ has reduced expressivity when compared with any of the listed data formats, but the choice of implementation technologies is maximized. Verification and validation will show that the resulting expressivity of the graph is sufficient for the purpose.&#xA;- **Federated data-spaces**: The general use of URIs (or UUIDs wirh namespace) as identifier like RDF allows linked data to reside in multiple internet servers and still form a valid graph which can be seamlessly traversed and queried.&#xA;&#xA;">
            <annotatedElement xmi:idref="_2024x_3_71e0233_1771839371696_26166_23059"/>
         </ownedComment>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741254707021_484850_42937"
                           name="aProperty">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741342097904_541640_44239"
                           body="Each property belongs to a single [[anEntity]], [[aRelationship]] or [[aPackage]]. A property has *no* identifier, thus a property update results in a new revision of the item to which it belongs. Is 'payload' having a clear meaning, datatype and range through the respective Property class.&#xA;&#xA;Details:&#xA;- A property may be required or not depending on the attributes minCount and maxCount of its class, but an existing property must have a value.&#xA;- A property may be composed of multiple properties to form a structured data set according to its [[Property]] class.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741254707021_484850_42937"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771692739541_536228_21128"
                             general="_2024x_3_71e0233_1771671893915_815790_18471"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741254957395_940432_43065"
                             visibility="public"
                             type="_19_0_3_71e0233_1741252869188_614_42852"
                             association="_19_0_3_71e0233_1741254957395_167721_43064">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1741509742234_854829_42911">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741254957395_940432_43065"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741259824343_252859_43498"
                             name="value"
                             visibility="public">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771718728629_186656_18721"
                              body="The value of a property.&#xA;&#xA;Details:&#xA;- If the datatype of the property's class is string, the value is a language string consisting of value and IETF language tag ('multiLangueText').&#xA;- Otherwise the value is a simple value.&#xA;- Values of all datatypes are represented as a string in all data formats, even JSON and JSON-LD.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741259824343_252859_43498"/>
               </ownedComment>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1741259835448_12910_43503"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741789524253_109831_44912"
                             visibility="public"
                             aggregation="composite"
                             type="_19_0_3_71e0233_1741254707021_484850_42937"
                             association="_19_0_3_71e0233_1741789524253_297295_44911">
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1741790404399_246618_44969"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741789524253_632145_44913"
                             visibility="public"
                             type="_19_0_3_71e0233_1741254707021_484850_42937"
                             association="_19_0_3_71e0233_1741789524253_297295_44911">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741790412834_462637_44974"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771693616773_590056_21246"
                           name="aSourceLink">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771842906599_156738_23457"
                           body="A link instance serving as source for a reified relationship.&#xA;&#xA;From a semantic point of view, there is no need to make a distinction between aSourceLink and aTargetLink at the metamodel level. The distinction can be done and *is made* at ontology level in the [[CASCaRA Semantic Infrastructure]]. However it is much easier to check the pattern/schema/shape and to ingest data, if the itemType is explicit.&#xA;&#xA;Details:&#xA;- aSourceLink may be required or not depending on the attributes minCount and maxCount of its class, but an existing one must have a value.&#xA;&#xA;&#xA;Example: &#xA;- A single 'satisfies' relationship can relate one or many function instances to a requirement instance. ">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771693616773_590056_21246"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771693679952_904979_21321"
                             general="_2024x_3_71e0233_1771676505284_159097_18793"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741776602722_98160_44400"
                           name="Identifiable"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741790714334_822940_44984"
                           body="All technical sub-classes of this class are identifiable, means they have an identifier, a title (name) and optionally a description. &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes are inherited by its subclasses.&#xA;- All class level items in the upper part of the diagram are commonly released and made available with an URL path including the revision. Hence, multiple revisions of the class set may exist in parallel.&#xA;- All instance level items in the lower part of the diagram may have individual revisions with their respective revision, modification date and creator. The prior revision identifier is memorized to support change history and branching. In case of a merge, there are two prior revisions.&#xA;&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741776602722_98160_44400"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771672400425_280792_18506"
                             general="_2024x_3_71e0233_1771671893915_815790_18471"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741776960082_840084_44503"
                             name="id"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778848412632_371576_20063"
                              body="A globally unique identifier, either a fully qualified URI or a name with namespace standing for an URI, see [[aPackage]] [[context]].">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741776960082_840084_44503"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1751542746757_462879_42095"
                             name="title"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778849047402_102076_20074"
                              body="A multiLanguageText. Maps to dcterms:title.&#xA;&#xA;Details:&#xA;- Here a multiplicity [0..1] is given, but in fact that depends on the itemType. &#xA;- For all classes (Enumeration, Property, Link, Entity and Relationship), a title is mandatory. &#xA;- In case of anEntity at least one of title or description is required, because it must be possible to represent a text paragraph as anEntity, which simply does not have a title.&#xA;- In case of aRelationship both title and description are optional. If missing the title and/or description of the respective Relationship class applies. This avoids lots of repetition in real-world data-sets.&#xA;- The same applies for aProperty, aSourceLink and aTargetLink; both title and description are optional.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1751542746757_462879_42095"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1751542767596_42271_42097"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1751542884336_630426_42099"
                             name="description"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778849061487_767528_20083"
                              body="A multiLanguageText.  Maps to dcterms:description.&#xA;&#xA;Details:&#xA;- Here a multiplicity [0..1] is given, but in fact that depends on the itemType. &#xA;- For all classes (Enumeration, Property, Link, Entity and Relationship), a title is mandatory. &#xA;- In case of anEntity at least one of title or description is required, because it must be possible to represent a text paragraph as anEntity, which simply does not have a title.&#xA;- In case of aRelationship both title and description are optional. If missing the title and/or description of the respective Relationship class applies. This avoids lots of repetition in real-world data-sets.&#xA;- The same applies for aProperty, aSourceLink and aTargetLink; both title and description are optional.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1751542884336_630426_42099"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1751542900833_553340_42101"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741777831234_907290_44608"
                           name="Element"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741790794793_390315_44989"
                           body="A technical super-class of [[Entity]] (class of entities) and [[Relationship]] (class of relationships). &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes and associations are inherited by its technical sub-classes Entity and Relationship.&#xA;- The globalTitle of the Elements is used to integrate the instances of a partial graphs to an overarching CASCaRA graph.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741777831234_907290_44608"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741862546691_733097_42828"
                             general="_19_0_3_71e0233_1741776602722_98160_44400"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741865323671_670283_43337"
                             visibility="public"
                             type="_19_0_3_71e0233_1741252869188_614_42852"
                             association="_19_0_3_71e0233_1741865323671_489728_43336">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741865411704_350121_43388"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1741865411704_229452_43389"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778849106391_766561_20088"
                             name="definition"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778849220748_25514_20103"
                              body="A multiLanguageText mandatory for all classes. Maps to skos:definition.&#xA;">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778849106391_766561_20088"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741776386192_365428_44395"
                             name="icon"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771715716608_434504_18671"
                              body="An icon defined with a class can be used to decorate the instances.&#xA;&#xA;Example: &#xA;- Folders as sub-class of Organizer and thus Entity may specify a UTF-8 character 🗀 for use by folders grouping certain model-elements.&#xA;- A data-URL of an icon is also permitted.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741776386192_365428_44395"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741776461803_470687_44397"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784875370972_558686_18457"
                             name="globalTitle"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784875538060_978517_18460"
                              body="The title assigned by matching the title with the terms of the ontology by the 'globalize' operation. ">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784875370972_558686_18457"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784875383688_336046_18458"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771688893681_342154_20442"
                           name="Link">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771713163633_745572_18472"
                           body="A Link is an identifiable link class. A Link is an owl:ObjectProperty.&#xA;&#xA;Example: &#xA;- An Organizer (semantic sub-class of Entity) may list Model-Elements (another semantic sub-class of Entity) to provide a document outline.&#xA;- As such the Link class *lists* is specified as enumeratedTargetLink by Organizer.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771688893681_342154_20442"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771689516347_856261_20587"
                             general="_2026x_14400d4_1784531708200_831990_18478"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771689151840_870998_20514"
                             visibility="public"
                             type="_19_0_3_71e0233_1741777831234_907290_44608"
                             association="_2024x_3_71e0233_1771689151840_201323_20513">
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771689330933_622459_20554"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778757251535_390860_18530"
                             name="minCount"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Integer"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778847005532_181133_19983"
                              body="An instance must have at least this number of properties of this class. Is '0' by default. This applies to both instances of a Property class and a Link class.&#xA;&#xA;For example, if a property class 'Priority' has a minCount=1 and a requirement class specifies an enumeratedProperty 'Priority', a requirement instance must have at least one property of class Priority (with a value).">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778757251535_390860_18530"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778757281294_314491_18533"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778757312955_163660_18541"
                             name="maxCount"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Integer"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778847146331_229884_19988"
                              body="An instance must have at most this number of properties of this class. Is unbounded (infinite) by default. This applies to both instances of a Property class and a Link class.&#xA;&#xA;For example, if a property class 'Priority' has a maxCount=1 and a requirement class specifies an enumeratedProperty 'Priority', a requirement instance must have no more than one property of class Priority (with a value).">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778757312955_163660_18541"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778757334208_53150_18544"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784286926444_450686_18501"
                             name="revisionAware"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784287446481_104885_18504"
                              body="Indicates whether an instance of this class points to a *specific* or *any* revision of the specified endpoint. In case of the former, the key of such a link instance must contain both identifier and revision. Default is false, so the relationship points to any revision of the endpoint; in that case the key only contains just the identifier.&#xA;&#xA;Examples:&#xA;- A 'lists' link of an outline shall continue to apply to an endpoint, even if updated. So *revisionAware* is omitted or set to 'false'.&#xA;- A 'verifies' relation shall apply between specific revisions of a *test-case* and a *requirement*. So the classes of both aSourceLink and aTargetLink set *revisionAware* to 'true'. If the *requirement* is updated, it does not have a 'verifies' link, until explicitly set after repeating the *test-case*. &#xA;- Of course, only one of the link classes of a Relationship class can be 'revisionAware'.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784286926444_450686_18501"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784286947462_87122_18502"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778759761855_929785_19242"
                             visibility="public"
                             type="_2024x_3_71e0233_1771688893681_342154_20442"
                             association="_2026x_14400d4_1778759761854_999807_19241">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778759920418_318508_19278"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784530107030_514282_18472"
                             name="defaultValue"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784530330288_695573_18475"
                              body="Optional default value(s) in case a modelElement's property does not have an individual value when instantiated.  It may be changed later on and must follow the definitions of the PropertyClass resp. LinkClass at all times, of course.&#xA;&#xA;Here, the attribute is named 'defaultValue' for clarity and may just be called 'value' in an implementation, as all restrictions and operations of a property's value apply.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784530107030_514282_18472"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784530179819_553404_18473"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784450703044_915775_18468"
                             name="readOnly"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784450750345_670668_18471"
                              body="The link value of an instance may not be updated or deleted, once assigned. &#xA;">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784450703044_915775_18468"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784450718436_929383_18469"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771693534418_96399_21170"
                           name="aTargetLink">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771844069583_721804_23482"
                           body="A link instance pointing to the target of a reified aRelationship or to one or more targets of anEntity.&#xA;&#xA;From a semantic point of view, there is no need to make a distinction between aSourceLink and aTargetLink at the metamodel level. The distinction can be done and *is made* at ontology level in the [[CASCaRA Semantic Infrastructure]]. However it is much easier to check the pattern/schema/shape and to ingest data, if the itemType is explicit.&#xA;&#xA;Details:&#xA;- aTargetLink may be required or not depending on the attributes minCount and maxCount of its class, but an existing one must have a value.&#xA;&#xA;Example: &#xA;- A 'satisfies' relationship can relate a function instance to one or multiple requirement instances (targets).&#xA;- An organizer (see [[CASCaRA Semantic Infrastructure]]) such as a chapter title (folder) in an outline can point to one or more contained items, be it anEntity or aRelationship or other.&#xA;- [[anEntity]], [[aRelationship]] or [[aPackage]] may point to value of an [[Enumeration]].">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771693534418_96399_21170"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771693689032_580615_21328"
                             general="_2024x_3_71e0233_1771676505284_159097_18793"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741332240391_169353_43869"
                           name="Entity">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741558807067_486101_44029"
                           body="Entity is a class of model elements, such as a system component or a requirement. An Entity is an owl:Class.&#xA;&#xA;Details:&#xA;- Entity should have a title (name) and may have a description (definition).&#xA;- Entity may specify (configure) zero to many classes of properties its instances may have. &#xA;- The definitions of the entity together with those of the properties may be used to build user dialogs with input verification as well as to check its instances whether all property values have a correct type and value range as well as whether all required ones are present.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741332240391_169353_43869"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741332297386_827363_43916"
                             general="_19_0_3_71e0233_1741777831234_907290_44608"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771675468832_870309_18689"
                             visibility="public"
                             type="_19_0_3_71e0233_1741332240391_169353_43869"
                             association="_2024x_3_71e0233_1771675468832_99975_18688">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771675530131_161954_18711"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771691052920_799372_20597"
                             visibility="public"
                             type="_2024x_3_71e0233_1771688893681_342154_20442"
                             association="_2024x_3_71e0233_1771691052920_190026_20596">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771691431808_733774_20654"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771691431809_927403_20655"
                            value="*"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741332525039_556704_43936"
                           name="anEntity">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741559058001_499741_44030"
                           body="Is used for instances of model-elements such as a system component or a requirement. Is 'payload' having a clear meaning through the respective Entity class.&#xA;&#xA;Details:&#xA;- An entity must have either a title or a description - or both. This allows to compose documents including text paragraphs without title. &#xA;- The entity's class enumerates the classes of properties it may have.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741332525039_556704_43936"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741336330695_326450_44001"
                             general="_19_0_3_71e0233_1741860988628_327516_42251"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741336386434_884494_44018"
                             visibility="public"
                             type="_19_0_3_71e0233_1741332240391_169353_43869"
                             association="_19_0_3_71e0233_1741336386434_654832_44017">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1741509755014_858754_42916">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741336386434_884494_44018"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778760425419_155860_19449"
                             visibility="public"
                             aggregation="composite"
                             type="_2024x_3_71e0233_1771693534418_96399_21170"
                             association="_2026x_14400d4_1778760425418_46283_19448">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778760519843_491018_19475"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2026x_14400d4_1778760519843_862417_19476"
                            value="*"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741252702146_888127_42789"
                           name="aRelationship">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741592222198_842166_44033"
                           body="Is used for relations between entities, such as a 'system component satisfies a requirement'. All relationships are bilateral and directed. Is 'payload' having a clear meaning through the respective Relationship class.&#xA;&#xA;Details:&#xA;- This is a reified graph edge and must have exactly one source and target entity each. The source must be an entity or relationship with a class defined by an eligible source class of its [[Relationship]]. The same applies for the target.&#xA;- Even though a relationship instance may have an individual title, it is advised to omit it and assume its class' title when needed to assure that relationships of the same class are named equally.&#xA;- The relationship's class enumerates the classes of properties it may have.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741252702146_888127_42789"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741332335305_810734_43923"
                             general="_19_0_3_71e0233_1741860988628_327516_42251"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741252750514_732063_42832"
                             visibility="public"
                             type="_19_0_3_71e0233_1741251882847_25282_42662"
                             association="_19_0_3_71e0233_1741252750514_868235_42831">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1741507934383_405120_42896">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741252750514_732063_42832"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778757667617_579985_18568"
                             visibility="public"
                             aggregation="composite"
                             type="_2024x_3_71e0233_1771693534418_96399_21170"
                             association="_2026x_14400d4_1778757667617_840696_18567"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778757924506_404198_18642"
                             visibility="public"
                             aggregation="composite"
                             type="_2024x_3_71e0233_1771693616773_590056_21246"
                             association="_2026x_14400d4_1778757924505_877189_18641"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771671893915_815790_18471"
                           name="Item"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771709589565_86976_22239"
                           body="The technical super-class of all CASCaRA metamodel items specifying the type of item to allow for simple schema checking and transformation.&#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771671893915_815790_18471"/>
            </ownedComment>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771672787619_626535_18519"
                             name="itemType"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771699113082_722432_22164"
                              body="Classifies classes and individuals (instances) in terms of this metamodel. It must be made explicit in all representations without native reasoner, such as in object-oriented programming, JSON, JSON-LD and XML. It can be omitted in RDF/OWL, as at the top of the class hierarchy there shall be a class corresponding to the metamodel itemType (see [[CASCARA Semantic Infrastructure]] and the itemType can be derived with a standard OWL reasoner.&#xA;&#xA;Details:&#xA;- Here it is modeled as a string, but in fact it is an enumerated value from all concrete metamodel items (represented as UML classes), thus [Enumeration, Link, Property, Entity, Relationship, aPackage, aSourceLink, aTargetLink, aProperty, anEntity, aRelationship].">
                  <annotatedElement xmi:idref="_2024x_3_71e0233_1771672787619_626535_18519"/>
               </ownedComment>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2024x_3_71e0233_1771676505284_159097_18793"
                           name="aLink"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771842473990_564967_23450"
                           body="Is a technical super-class for link instances.&#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- A list of enumerated endpoints (references) per link instance is possible.&#xA;- If the class is set to *versionAware*, all pointers to an endpoint must contain both identifier and revision.&#xA;">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771676505284_159097_18793"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2024x_3_71e0233_1771693207577_136064_21161"
                             general="_2024x_3_71e0233_1771671893915_815790_18471"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771694213843_499235_21496"
                             visibility="public"
                             type="_19_0_3_71e0233_1741860988628_327516_42251"
                             association="_2024x_3_71e0233_1771694213843_559630_21495">
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771694487877_320583_21554"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771695135148_558357_21758"
                             visibility="public"
                             type="_2024x_3_71e0233_1771688893681_342154_20442"
                             association="_2024x_3_71e0233_1771695135147_834274_21757"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741860988628_327516_42251"
                           name="anElement"
                           isAbstract="true">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1743202141441_816783_42097"
                           body="A technical superclass of [[anEntity]] and [[aRelationship]]. &#xA;&#xA;Details:&#xA;- The class is abstract.&#xA;- All attributes and associations are inherited by its sub-classes.&#xA;- Sub-classes may have individual revisions with revision id, modification date and creator. The prior revision id is memorized to support change history and branching. In case of a merge, there are two prior revisions.&#xA;&#xA;&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741860988628_327516_42251"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741776754655_143942_44464"
                             general="_19_0_3_71e0233_1741776602722_98160_44400"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1742305034835_863968_42146"
                             visibility="public"
                             aggregation="composite"
                             type="_19_0_3_71e0233_1741254707021_484850_42937"
                             association="_19_0_3_71e0233_1742305034835_146161_42145">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1742305101265_141720_42175"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1742305101265_754531_42176"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741777082773_650555_44513"
                             name="modified"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771718753724_387064_18724"
                              body="A ISO-8601 DateTime value recording the point in time of the last change.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741777082773_650555_44513"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741777152479_29656_44527"
                             name="revision"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771718916336_540477_18727"
                              body="A unique string identifying the revision of the entity or relationship instance.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1741777152479_29656_44527"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741777211230_95986_44535"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1757615958224_290574_18448"
                             name="priorRevision"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1757690886964_651297_22383"
                              body="Links to the previous revisions of an entity or relationship instance. It is a list with &#xA;- zero elements, if it is the first revision,&#xA;- one element for a subsequent revision or&#xA;- two elements when two branches are merged.">
                  <annotatedElement xmi:idref="_2024x_3_71e0233_1757615958224_290574_18448"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1757690656363_338898_22381"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1757690656363_54491_22382"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748952227529_103968_42115"
                             name="creator"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771719096834_236721_18740"
                              body="The person committing the last change. Is often an e-mail address.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748952227529_103968_42115"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1748952318609_788352_42117"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_19_0_3_71e0233_1742305034835_146161_42145"
                           name="hasProperty">
            <memberEnd xmi:idref="_19_0_3_71e0233_1742305034835_863968_42146"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1742305034835_761929_42147"/>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_19_0_3_71e0233_1742305034835_761929_42147"
                       visibility="public"
                       type="_19_0_3_71e0233_1741860988628_327516_42251"
                       association="_19_0_3_71e0233_1742305034835_146161_42145"/>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_19_0_3_71e0233_1741789524253_297295_44911"
                           name="composes">
            <memberEnd xmi:idref="_19_0_3_71e0233_1741789524253_109831_44912"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1741789524253_632145_44913"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1753095010912_745711_42423"
                           body="The sequence of composed properties is defined by the [[pig:Property]]. To avoid inconsistencies, the sequence of properties of an element instance may be unordered, especially since some may not exist at all. Refer to the [[pig:Property]], if the ordering is of importance, for example for consistent viewing.&#xA;&#xA;Details:&#xA;- The class of the composing property must have sh:datatype xs:complexType.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741789524253_297295_44911"/>
            </ownedComment>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771675468832_99975_18688"
                           name="specializes">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771675468832_870309_18689"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771675468833_989858_18690"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771675871021_265016_18778"
                           body="This is a specialization at semantic level: A member of class Entity may specialize another member of class Entity. This corresponds to *owl:subClassOf*.&#xA;&#xA;Example: &#xA;- A QualityRequirement specializes a Requirement.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771675468832_99975_18688"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771675468833_989858_18690"
                       visibility="public"
                       type="_19_0_3_71e0233_1741332240391_169353_43869"
                       association="_2024x_3_71e0233_1771675468832_99975_18688">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771675541817_28045_18717"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771675541817_904960_18718"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771695135147_834274_21757"
                           name="hasClass">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771695135148_558357_21758"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771695135148_540872_21759"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771918194137_987265_18478"
                           body="Not needed in RDF and JSON-LD, as the class name is used as predicate.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771695135147_834274_21757"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771695135148_540872_21759"
                       visibility="public"
                       type="_2024x_3_71e0233_1771676505284_159097_18793"
                       association="_2024x_3_71e0233_1771695135147_834274_21757">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771695168341_904515_21777"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771695168341_110981_21778"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771691052920_190026_20596"
                           name="enumeratedTargetLink">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691052920_799372_20597"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691052920_66527_20598"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771720324984_179524_18747"
                           body="A list of allowable link classes of the Entity.&#xA;&#xA;Example:&#xA;- 'View' specializing 'Entity' (thus semantic super-class) may specify two enumeratedTargetLink 'shows' and 'depicts'. &#xA;- The former defines allowable links to model-elements visible on the diagram and the latter defines a link to a model-element owning the diagram (depicting its behavior or inner structure).">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771691052920_190026_20596"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771691052920_66527_20598"
                       visibility="public"
                       type="_19_0_3_71e0233_1741332240391_169353_43869"
                       association="_2024x_3_71e0233_1771691052920_190026_20596">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771691425563_546472_20648"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771691425563_714220_20649"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_19_0_3_71e0233_1741254957395_167721_43064"
                           name="hasClass">
            <memberEnd xmi:idref="_19_0_3_71e0233_1741254957395_940432_43065"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1741254957395_776217_43066"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1752736666705_495059_42105"
                           body="Not needed in RDF and JSON-LD, as the class name is used as predicate.">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741254957395_167721_43064"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_19_0_3_71e0233_1741254957395_776217_43066"
                       visibility="public"
                       type="_19_0_3_71e0233_1741254707021_484850_42937"
                       association="_19_0_3_71e0233_1741254957395_167721_43064">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741254982080_179462_43087"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1741254982080_988572_43088"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_19_0_3_71e0233_1741336386434_654832_44017"
                           name="hasClass">
            <memberEnd xmi:idref="_19_0_3_71e0233_1741336386434_884494_44018"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1741336386434_511600_44019"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741512730977_721342_43133"
                           body="Pointing to the class of an entity; corresponds to rdf:type and @type in JSON-LD.">
