         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771694213843_559630_21495"
                           name="hasEndpoint">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771694213843_499235_21496"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771694213844_145067_21497"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1778769052104_581343_19778"
                           body="aLink pointing to the element instance (anEntity or a Relationship. The element instance must have a class that is listed as enumeratedSourceLink or enumeratedTargetLink of the link's class.&#xA;&#xA;aTargetLink may also point to an enumeratedValue of an Enumeration (not shown on the diagram and not event contained in the model, yet).">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771694213843_559630_21495"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771694213844_145067_21497"
                       visibility="public"
                       type="_2024x_3_71e0233_1771676505284_159097_18793"
                       association="_2024x_3_71e0233_1771694213843_559630_21495">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771694462779_690450_21545"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771694462779_771848_21546"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741252869188_614_42852"
                           name="Property">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741594565995_437004_44035"
                           body="Every class [[Entity]] and [[Relationship]] can have an individual set of configurable properties, each of which is uniquely defined by datatype and range. A Property is an owl:ObjectProperty when enumeratedValues are defined and is an owl:DatatypeProperty otherwise.&#xA;&#xA;Example: A requirement might have a list with three properties, such as &#xA;- *Title* with data type „String of max. length 96“, &#xA;- *Description* with data type „String“ wíthout length restriction and &#xA;- *Priority* with data type „String with a single choice of ['high', 'medium', 'low']“.&#xA;&#xA;Details:&#xA;- Property class must have a title and may have a description named.&#xA;- Property class may define a minimum and maximum count of values.&#xA;- Property class must define a datatype and may restrict its range by minInclusive, maxInclusive or or a pattern defined by Regular Expression.&#xA;-  Property class may define a set of enumerated values which must of course satisfy its own data type and range&#xA;- A property class may define a default value which must of course satisfy its own data type and range.&#xA;- Property class may be composed of multiple property classes to form a structured data type (xs:complexType). The structure must be a tree, thus without cyclic dependency.&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741252869188_614_42852"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2026x_14400d4_1784532049597_278811_18580"
                             general="_2026x_14400d4_1784531708200_831990_18478"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748952952204_277375_42119"
                             name="datatype"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1748953193291_135526_42123"
                              body="One of the xs: data types. Shall be anyURI.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748952952204_277375_42119"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748949941816_8091_42095"
                             name="maxLength"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Integer"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771716729493_748422_18684"
                              body="Maximum length of a property value with datatype 'xs:string'. Is not allowed with any other datatype.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748949941816_8091_42095"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1748949963754_267922_42097"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748950030952_929749_42099"
                             name="minInclusive"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Real"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771716938691_495061_18691"
                              body="The minimum value a property of this type may have. May be applied only for numeric datatypes.  It the intrinsic minimum value of the datatype by default.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748950030952_929749_42099"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1748950050129_76990_42101"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748950114069_51401_42103"
                             name="maxInclusive"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Real"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2024x_3_71e0233_1771717010672_965051_18694"
                              body="The maximum value a property of this type may have. May be applied only for numeric datatypes. It the intrinsic maximum value of the datatype by default.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748950114069_51401_42103"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1748950126363_551517_42105"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1748950213739_692776_42111"
                             name="pattern"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_19_0_3_71e0233_1749058650297_727315_42095"
                              body="A Regular Expression that must evaluate successfully with the property value. Can also be used to limit the number of decimals of a number, as there is no restriction like xs:fractionDigits in SHACL.">
                  <annotatedElement xmi:idref="_19_0_3_71e0233_1748950213739_692776_42111"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1748950237058_513634_42113"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741789444990_934923_44877"
                             visibility="public"
                             aggregation="composite"
                             type="_19_0_3_71e0233_1741252869188_614_42852"
                             association="_19_0_3_71e0233_1741789444990_72187_44876">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741790353426_145533_44948"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_19_0_3_71e0233_1741790353426_827337_44949"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_19_0_3_71e0233_1741789444990_312639_44878"
                             visibility="public"
                             type="_19_0_3_71e0233_1741252869188_614_42852"
                             association="_19_0_3_71e0233_1741789444990_72187_44876">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_19_0_3_71e0233_1741790377520_504247_44958"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771681333802_187406_19091"
                             visibility="public"
                             type="_19_0_3_71e0233_1741252869188_614_42852"
                             association="_2024x_3_71e0233_1771681333802_367616_19090">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771681506214_254727_19160"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_19_0_3_71e0233_1741251882847_25282_42662"
                           name="Relationship">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1741590377778_388541_44031"
                           body="Relationship is a class of relationships between two entities to allow assertions such as 'a system component satisfies a requirement'. All relationships are bilateral and directed. This allows for statements according to propositional logic. They can be easily mapped to many technologies such as RDF or even ReqIF. Being reified, a Relationship is an owl:Class.&#xA;&#xA;Details:&#xA;- Relationship must have a title (name) and may have a description (definition).&#xA;- Relationship lists zero to many property classes its instances may have.&#xA;- Relationship may define (configure) entitiy classes or relationship classes, whose instances are eligible as source resp. target in a relationship. If none are defined, all entities and relationships are eligible.&#xA;- Relationship is reified (as a rdfs:Resource in RDF), so that it can be a source or target of another Relationship - to make a statement on a statement.&#xA;- The definitions of a relationship together with those of their properties may be used to build user dialogs with input verfication and to check its instances whether all properties have a correct type and value range as well as whether all required ones are present.&#xA;&#xA;">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741251882847_25282_42662"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_19_0_3_71e0233_1741332039956_592208_43815"
                             general="_19_0_3_71e0233_1741777831234_907290_44608"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771680866524_738569_18955"
                             visibility="public"
                             type="_19_0_3_71e0233_1741251882847_25282_42662"
                             association="_2024x_3_71e0233_1771680866523_185148_18954">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771681029114_443058_19014"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771691521424_898837_20685"
                             visibility="public"
                             type="_2024x_3_71e0233_1771688893681_342154_20442"
                             association="_2024x_3_71e0233_1771691521424_341386_20684"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2024x_3_71e0233_1771691684070_143422_20753"
                             visibility="public"
                             type="_2024x_3_71e0233_1771688893681_342154_20442"
                             association="_2024x_3_71e0233_1771691684070_278169_20752"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1784880575965_465476_18467"
                             name="globalReversed"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#Boolean"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784880672559_503608_18468"
                              body="If set, the instances of the Relationship are interpreted in reverse direction when evaluated in the global graph.&#xA;&#xA;Example:&#xA;- If the ontology defines a term 'satisfies', an incoming relationship named 'satisfied-by' is reversed and the globalTitle is set to 'satisfies' and globalReversed is set to 'true'.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1784880575965_465476_18467"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1784882474003_199342_18469"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771691684070_278169_20752"
                           name="enumeratedTargetLink">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691684070_143422_20753"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691684070_576430_20754"/>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771691684070_576430_20754"
                       visibility="public"
                       type="_19_0_3_71e0233_1741251882847_25282_42662"
                       association="_2024x_3_71e0233_1771691684070_278169_20752">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771691737248_731214_20782"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771691737249_186462_20783"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771680866523_185148_18954"
                           name="specializes">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771680866524_738569_18955"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771680866524_499684_18956"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771683464743_969186_19208"
                           body="This is a specialization at semantic level: A member of class Relationship may specialize another member of class Relationship. This corresponds to *owl:subClassOf*, since relationships are reified.&#xA;&#xA;Example: &#xA;- Relationships 'satisfies', verifies', 'refines', 'impacts' all specialize the rather general relationship 'trace'.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771680866523_185148_18954"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771680866524_499684_18956"
                       visibility="public"
                       type="_19_0_3_71e0233_1741251882847_25282_42662"
                       association="_2024x_3_71e0233_1771680866523_185148_18954">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771681036134_306390_19020"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771681036134_772121_19021"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771691521424_341386_20684"
                           name="enumeratedSourceLink">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691521424_898837_20685"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771691521424_866488_20686"/>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771691521424_866488_20686"
                       visibility="public"
                       type="_19_0_3_71e0233_1741251882847_25282_42662"
                       association="_2024x_3_71e0233_1771691521424_341386_20684">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771691597864_954485_20714"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771691597864_930627_20715"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_2024x_3_71e0233_1771681333802_367616_19090"
                           name="specializes">
            <memberEnd xmi:idref="_2024x_3_71e0233_1771681333802_187406_19091"/>
            <memberEnd xmi:idref="_2024x_3_71e0233_1771681333802_505736_19092"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1771684224451_958197_19219"
                           body="This is a specialization at semantic level: A member of class Property may specialize another member of class Property. This corresponds to *owl:subPropertyOf* with all implications (constraints such as the range of a sub-property can be reduced, but not enlarged, when compared with the super-property).&#xA;&#xA;Example: &#xA;- The property 'o:Rationale' might be a specialization of 'dcterms:description' with an equal or reduced range.">
               <annotatedElement xmi:idref="_2024x_3_71e0233_1771681333802_367616_19090"/>
            </ownedComment>
            <ownedEnd xmi:type="uml:Property"
                       xmi:id="_2024x_3_71e0233_1771681333802_505736_19092"
                       visibility="public"
                       type="_19_0_3_71e0233_1741252869188_614_42852"
                       association="_2024x_3_71e0233_1771681333802_367616_19090">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2024x_3_71e0233_1771681514708_796799_19166"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2024x_3_71e0233_1771681514708_334291_19167"
                            value="*"/>
            </ownedEnd>
         </packagedElement>
         <packagedElement xmi:type="uml:Association"
                           xmi:id="_19_0_3_71e0233_1741789444990_72187_44876"
                           name="composes">
            <memberEnd xmi:idref="_19_0_3_71e0233_1741789444990_934923_44877"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1741789444990_312639_44878"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2024x_3_71e0233_1757265867580_724370_18715"
                           body="The composing property class must have sh:datatype xs:complexType.">
               <annotatedElement xmi:idref="_19_0_3_71e0233_1741789444990_72187_44876"/>
            </ownedComment>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2026x_14400d4_1778225800958_455467_18486"
                           name="Enumeration">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1778846138297_698542_19920"
                           body="A class defining a set of enumerated values for use by any set of instances, where each value has an id and a value, either multiLanguageText in case of datatype xs:string or a simple value for all other datatypes. &#xA;&#xA;A corresponding Link class must be defined with an enumeratedEndpoint to this enumeration class. An instance then has zero to many (0..n) aTargetLinks pointing to a value of the enumeration with hasTargetLink _(not yet shown in the model diagram - this design is somewhat cumbersome and needs review)_.  The required number of values is defined by minCount and maxCount of the Link class.">
               <annotatedElement xmi:idref="_2026x_14400d4_1778225800958_455467_18486"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2026x_14400d4_1778226617659_804091_18605"
                             general="_19_0_3_71e0233_1741777831234_907290_44608"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778760014795_708628_19319"
                             visibility="public"
                             type="_2026x_14400d4_1778225800958_455467_18486"
                             association="_2026x_14400d4_1778760014795_126459_19318">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778760206264_490207_19389"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778847225745_801455_19999"
                             name="datatype"
                             visibility="public">
               <type href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778847254755_925651_20002"
                              body="A unit as defined by the International System of Units (SI). A unit can only be defined for a numeric datatype. By default the property has no unit.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778847225745_801455_19999"/>
               </ownedComment>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778798043236_583508_19825"
                             name="enumeratedValue"
                             visibility="public">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1784821035724_38322_18463"
                              body="A defined value of an [[Enumeration]]. &#xA;&#xA;Details:&#xA;- It must have the datatype specified by its parent.&#xA;- If the datatype is string, the value is a language string consisting of value and IETF language tag ('multiLangueText').&#xA;- Otherwise the value is a simple value.&#xA;- Values of all datatypes are represented as a string in all data formats, even JSON and JSON-LD.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778798043236_583508_19825"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778798055553_831257_19828"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2026x_14400d4_1778798055553_913070_19829"
                            value="*"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2026x_14400d4_1778225937554_355279_18509"
                           name="aPackage">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1778850931822_800704_20232"
                           body="A container for any selection of metamodel items. Standardized and addressable classes can be excluded from aPackage. Thus aPackage contains specific classes (from organization or project ontologies) plus the instances of interest.&#xA;&#xA;Details:&#xA;- The class of aPackage is formally Entity, but should be a subclass of Organizer (see [[CASCaRA Semantic Infrastructure]]).&#xA;- aPackage can be nested.&#xA;- Additional properties such as *license*, *contributor* or *import* nested packages are enumerated in the class of Package.&#xA;">
               <annotatedElement xmi:idref="_2026x_14400d4_1778225937554_355279_18509"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2026x_14400d4_1778226289510_400966_18545"
                             general="_19_0_3_71e0233_1741332525039_556704_43936"/>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778749129918_571002_18463"
                             name="context"
                             visibility="public">
               <ownedComment xmi:type="uml:Comment"
                              xmi:id="_2026x_14400d4_1778760848476_417962_19533"
                              body="A list of IRIs per namespace abbreviation. Used as sequence of @prefix in RDF/Turtle, sequence of xmlns: in XML and @context in JSON-LD.">
                  <annotatedElement xmi:idref="_2026x_14400d4_1778749129918_571002_18463"/>
               </ownedComment>
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778749246334_169932_18466"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
                            xmi:id="_2026x_14400d4_1778749246335_69629_18467"
                            value="*"/>
            </ownedAttribute>
            <ownedAttribute xmi:type="uml:Property"
                             xmi:id="_2026x_14400d4_1778760662539_811343_19509"
                             visibility="public"
                             aggregation="composite"
                             type="_19_0_3_71e0233_1741776602722_98160_44400"
                             association="_2026x_14400d4_1778760662539_45245_19508">
               <lowerValue xmi:type="uml:LiteralInteger"
                            xmi:id="_2026x_14400d4_1778760711475_496715_19525"/>
               <upperValue xmi:type="uml:LiteralUnlimitedNatural"
