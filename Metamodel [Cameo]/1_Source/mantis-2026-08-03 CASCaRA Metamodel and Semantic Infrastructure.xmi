         <packagedElement xmi:type="uml:Class"
                           xmi:id="_2026x_14400d4_1786351746597_162109_38448"
                           name="Collection">
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_2026x_14400d4_1786352850842_260697_38455"
                           body="A 'Collection' is a logical (often conceptual) group of resources linked with a  relationship (tbd). It corresponds to a 'Group' in BPMN or a 'Grouping' in ArchiMate.&#xA;- BPMN: An arbitrary set of objects can be defined as a Group to show that they logically belong together. Source: [BPMN Tutorial](http://www.bpmn-tool.com/en/tutorial/).&#xA;- ArchiMate: The grouping element aggregates or composes concepts that belong together based on some common characteristic. Source: [ArchiMate® 3.2 Specification](https://pubs.opengroup.org/architecture/archimate3-doc/ch-Generic-Metamodel.html#sec-Grouping).">
               <annotatedElement xmi:idref="_2026x_14400d4_1786351746597_162109_38448"/>
            </ownedComment>
            <generalization xmi:type="uml:Generalization"
                             xmi:id="_2026x_14400d4_1786352085264_257088_38450"
                             general="_2024x_3_71e0233_1771752760974_602036_19203"/>
         </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package"
