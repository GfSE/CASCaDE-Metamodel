                           name="hasClass">
            <memberEnd xmi:idref="_19_0_3_71e0233_1741252750514_732063_42832"/>
            <memberEnd xmi:idref="_19_0_3_71e0233_1741252750514_434723_42833"/>
            <ownedComment xmi:type="uml:Comment"
                           xmi:id="_19_0_3_71e0233_1752736653125_750910_42104"
                           body="Pointing to the class of a relationship; corresponds to rdf:type and @type in JSON-LD.">
